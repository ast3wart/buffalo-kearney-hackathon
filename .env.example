# Afterlife environment. Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never commit real keys.

# Claude API, used by POST /brief (afterlife/brief.py). Leave blank to use the template fallback.
ANTHROPIC_API_KEY=

# Pinned at CP1 (Sat Nov 14). Read by afterlife/run.py (recorded in the runs table); afterlife/brief.py
# will use it for the Claude calls. Change only together with AFTERLIFE_PROMPT_VERSION.
AFTERLIFE_LLM_MODEL=claude-sonnet-5-5
AFTERLIFE_PROMPT_VERSION=v1
