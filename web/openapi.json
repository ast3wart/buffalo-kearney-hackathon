{
  "openapi": "3.1.0",
  "info": {
    "title": "Afterlife API",
    "version": "0.1.0"
  },
  "paths": {
    "/companies": {
      "get": {
        "summary": "List Companies",
        "operationId": "list_companies_companies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Company"
                  },
                  "type": "array",
                  "title": "Response List Companies Companies Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/overview": {
      "get": {
        "summary": "Overview",
        "description": "\ud83d\udcb2 Coverage, build vs lifecycle cost per product, and the headline savings figures.",
        "operationId": "overview_overview_get",
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "company_id from GET /companies",
              "title": "Company"
            },
            "description": "company_id from GET /companies"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/markups": {
      "get": {
        "summary": "Markups",
        "description": "\ud83d\udcb2 Same part, service price vs production price (high-confidence links only), biggest overspend first.",
        "operationId": "markups_markups_get",
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Company"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 25,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Markup"
                  },
                  "title": "Response Markups Markups Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/harmonization": {
      "get": {
        "summary": "Harmonization",
        "description": "\ud83d\udcb2 Production lines paid above the best supplier x plant price for the same part.",
